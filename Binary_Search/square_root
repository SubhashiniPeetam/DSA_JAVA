int floorSqrt(int n) {
    // Your code goes here
    int st =0, end = n;
        while(st<=end)
        {
            int mid = st+(end-st)/2;
            if(mid*mid==n)
            {
                return mid;
            }
            else if(mid*mid>n)
            {
                end = mid-1;

            }
            else {
                st = mid+1;
            }
        }
        return end;
}
