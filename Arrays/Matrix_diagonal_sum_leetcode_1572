class Solution {
    public int diagonalSum(int[][] mat) {
        int sum=0;
        for(int i=0;i<mat[0].length;i++)
        {
            sum=sum+mat[i][i];
        }

        for(int i=0;i<mat.length;i++)
        {
            if(i!=mat[i].length-1-i)
            {
                sum=sum+mat[i][mat[i].length-1-i];
            }
        }
        return sum;
    }
}
