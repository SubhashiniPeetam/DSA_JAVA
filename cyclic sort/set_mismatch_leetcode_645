//https://leetcode.com/problems/set-mismatch/description/
class Solution {
    public static void swap(int[] arr,int i,int idx)
    {
        int temp = arr[i];
        arr[i] = arr[idx];
        arr[idx] = temp;
    }

    public static void sortSet(int[] arr)
    {
        int i = 0, n = arr.length;
        while(i<n)
        {
            int idx = arr[i]-1;
            if(arr[i]==i+1 || arr[i]==arr[idx])
            {
                i++;
            }
            else
            {
                swap(arr,i,idx);
            }
        }
    }
    public int[] findErrorNums(int[] arr) {
       int[] ans = new int[2];
       sortSet(arr);
       for(int i=0;i<arr.length;i++)
        {
            if(arr[i]!=i+1)
            {
                ans[0] = arr[i];
                ans[1] = i+1;
                break;
            }
        }
        return ans; 
    }
}
