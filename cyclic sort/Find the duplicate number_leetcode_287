//https://leetcode.com/problems/find-the-duplicate-number/description/
class Solution {
    public void swap(int[] arr,int i,int idx)
    {
        int temp = arr[i];
        arr[i] = arr[idx];
        arr[idx] = temp;
    }

    public int findDuplicate(int[] arr) {
        int i = 0, n = arr.length;
        while(i<n) {
            int idx = arr[i] - 1;
            if (arr[i] == i + 1) {
                i++;
            } else if (arr[idx] == arr[i]) {
                return arr[i];
            } else {
                swap(arr, i, idx);
            }
        }
        return 0;
        
    }
}
