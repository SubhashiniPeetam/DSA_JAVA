import java.util.Scanner;

public class pattern4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter n:");
        int n = sc.nextInt();

        for(int i=1;i<=n;i++)
        {
            char ch='A';
            for(int j=1;j<=n;j++)
            {
                System.out.print(ch+" ");
                ch++;
            }
            System.out.println();
        }

        sc.close();

    }
}


